<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020F18">

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="94dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:text="☰"
                    android:textSize="20sp"
                    android:textColor="#E7F7FF"
                    android:contentDescription="Menu"
                    app:cornerRadius="14dp"
                    app:backgroundTint="#071C29"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Sensei Tunnel"
                    android:textColor="#F2FAFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:minWidth="0dp"
                    android:text="⚙"
                    android:textSize="20sp"
                    android:textColor="#DCEFFF"
                    android:contentDescription="Settings"
                    app:cornerRadius="14dp"
                    app:backgroundTint="#071C29"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/dashboard_card_bg">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tvConnectionState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Disconnected"
                            android:textColor="#F1F7FA"
                            android:textSize="17sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Tap to connect"
                            android:textColor="#7993A1"
                            android:textSize="11sp"/>
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConnect"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:minWidth="0dp"
                        android:text="◉"
                        android:textSize="26sp"
                        android:textColor="#F1FBFF"
                        app:cornerRadius="32dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="#24617E"
                        app:backgroundTint="#153E57"/>
                </LinearLayout>
                <TextView
                    android:id="@+id/tvSelectedServerHome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Bundled OpenVPN profile"
                    android:textColor="#C9E1EA"
                    android:textSize="12sp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↓ Download" android:textColor="#718B99" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvDownloadSpeed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 B" android:textColor="#4BDFFF" android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↑ Upload" android:textColor="#718B99" android:textSize="10sp"/>
                        <TextView android:id="@+id/tvUploadSpeed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 B" android:textColor="#56D6A0" android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvDeviceContext" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Country • Network" android:textColor="#718B99" android:textSize="10sp" android:gravity="end"/>
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="SERVER &amp; CONFIG" android:textColor="#7793A0" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.16"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnServerListHome"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="▤   Server List                                      ›"
                android:textAlignment="viewStart"
                android:textColor="#E2F4FA"
                android:textSize="13sp"
                app:backgroundTint="#071F2D"
                app:cornerRadius="15dp"
                app:strokeColor="#123C50"
                app:strokeWidth="1dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFreeServersHome"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="◎   Free Servers                                      ›"
                android:textAlignment="viewStart"
                android:textColor="#E2F4FA"
                android:textSize="13sp"
                app:backgroundTint="#071F2D"
                app:cornerRadius="15dp"
                app:strokeColor="#123C50"
                app:strokeWidth="1dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPayloadsHome"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="◈   Payload List                                      ›"
                android:textAlignment="viewStart"
                android:textColor="#E2F4FA"
                android:textSize="13sp"
                app:backgroundTint="#071F2D"
                app:cornerRadius="15dp"
                app:strokeColor="#123C50"
                app:strokeWidth="1dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettingsHome"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="7dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="⚙   Settings                                          ›"
                android:textAlignment="viewStart"
                android:textColor="#E2F4FA"
                android:textSize="13sp"
                app:backgroundTint="#071F2D"
                app:cornerRadius="15dp"
                app:strokeColor="#123C50"
                app:strokeWidth="1dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Server catalog" android:textColor="#6F8996" android:textSize="10sp"/>
                <TextView android:id="@+id/tvServerCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 servers" android:textColor="#50DFFF" android:textSize="10sp"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Payload library" android:textColor="#6F8996" android:textSize="10sp"/>
                <TextView android:id="@+id/tvPayloadCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 payloads" android:textColor="#50DFFF" android:textSize="10sp"/>
            </LinearLayout>

            <!-- Hidden functional controls kept for the existing VPN engine. -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/tvImportedFiles" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAddConfig" android:layout_width="match_parent" android:layout_height="48dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnImportConfig" android:layout_width="match_parent" android:layout_height="48dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPayload" android:layout_width="match_parent" android:layout_height="48dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnManualConfig" android:layout_width="match_parent" android:layout_height="48dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnAddServerHome" android:layout_width="match_parent" android:layout_height="48dp"/>
                <TextView android:id="@+id/tvProfileInfo" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnOpenVpn" android:layout_width="match_parent" android:layout_height="48dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnV2Ray" android:layout_width="match_parent" android:layout_height="48dp"/>
                <Spinner android:id="@+id/spinnerProtocol" android:layout_width="match_parent" android:layout_height="48dp"/>
                <Spinner android:id="@+id/spinnerProfile" android:layout_width="match_parent" android:layout_height="48dp"/>
                <LinearLayout android:id="@+id/configList" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvSessionUsage" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnClearConfig" android:layout_width="match_parent" android:layout_height="48dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnReload" android:layout_width="match_parent" android:layout_height="48dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSpeedTest" android:layout_width="match_parent" android:layout_height="48dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnFavoritesHome" android:layout_width="match_parent" android:layout_height="48dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnLogsHome" android:layout_width="match_parent" android:layout_height="48dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnQuickConnectHome" android:layout_width="match_parent" android:layout_height="48dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        android:padding="4dp"
        android:gravity="center"
        android:background="@drawable/bottom_nav_bg">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnHomeNav" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="⌂\nHome" android:textSize="9sp" android:textColor="#48DFFF" android:gravity="center" app:backgroundTint="#0A2A3A" app:cornerRadius="14dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnServersNav" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="≡\nServers" android:textSize="9sp" android:textColor="#9BB0BA" android:gravity="center" app:backgroundTint="#061A25" app:cornerRadius="14dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnPayloadNav" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="◈\nPayloads" android:textSize="9sp" android:textColor="#9BB0BA" android:gravity="center" app:backgroundTint="#061A25" app:cornerRadius="14dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSettingsNav" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1" android:text="⚙\nSettings" android:textSize="9sp" android:textColor="#9BB0BA" android:gravity="center" app:backgroundTint="#061A25" app:cornerRadius="14dp"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/splashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#020F18"
        android:elevation="30dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
            <ImageView android:id="@+id/ivSplashLogo" android:layout_width="180dp" android:layout_height="260dp" android:src="@drawable/sensei_logo" android:scaleType="fitCenter" android:contentDescription="Sensei Tunnel"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="V5" android:textColor="#8D7CFF" android:textSize="22sp" android:textStyle="bold" android:layout_marginTop="-18dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fast • Secure • Freedom" android:textColor="#D5ECF4" android:textSize="12sp" android:layout_marginTop="2dp"/>
            <View android:layout_width="105dp" android:layout_height="4dp" android:layout_marginTop="28dp" android:background="#0876B6"/>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
