<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#020F18">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Build a payload" android:textColor="#E2F4FA" android:textStyle="bold" android:textSize="18sp" android:paddingBottom="4dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Generate an HTTP/CONNECT payload, then review it before saving." android:textColor="#7896A4" android:textSize="11sp" android:paddingBottom="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:orientation="horizontal">
            <RadioButton android:id="@+id/rNormal" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Normal" android:textColor="#E2F4FA" android:buttonTint="#14BFFF" android:background="#0A2A3A"/>
            <RadioButton android:id="@+id/rSplit" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Split" android:textColor="#E2F4FA" android:buttonTint="#14BFFF"/>
            <RadioButton android:id="@+id/rDirect" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Direct" android:textColor="#E2F4FA" android:buttonTint="#14BFFF"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="URL / HOST" android:textColor="#7896A4" android:textSize="10sp" android:paddingTop="12dp" android:paddingBottom="4dp"/>
        <EditText android:id="@+id/paygenEditText" android:layout_width="match_parent" android:layout_height="54dp" android:hint="example.com" android:textColor="#E2F4FA" android:textColorHint="#607F8D" android:textSize="13sp" android:padding="12dp" android:singleLine="true" android:background="#051B29"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="5dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Request Method" android:textColor="#7896A4" android:textSize="10sp"/>
                <Spinner android:id="@+id/request_spin" android:layout_width="match_parent" android:layout_height="48dp" android:spinnerMode="dialog" android:background="#051B29"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="5dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Injection" android:textColor="#7896A4" android:textSize="10sp"/>
                <Spinner android:id="@+id/inject_spin" android:layout_width="match_parent" android:layout_height="48dp" android:spinnerMode="dialog" android:background="#051B29"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp">
            <CheckBox android:id="@+id/cbFront" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Front Query" android:textColor="#D7EDF5" android:buttonTint="#14BFFF"/>
            <CheckBox android:id="@+id/cbBack" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:text="Back Query" android:textColor="#D7EDF5" android:buttonTint="#14BFFF"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Split method" android:textColor="#7896A4" android:textSize="10sp" android:paddingTop="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:orientation="horizontal">
            <CheckBox android:id="@+id/cbRotate" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="Rotate" android:textColor="#D7EDF5" android:buttonTint="#14BFFF"/>
            <Spinner android:id="@+id/split_spin" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:spinnerMode="dialog" android:background="#051B29"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Extra headers" android:textColor="#7896A4" android:textSize="10sp" android:paddingTop="8dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <CheckBox android:id="@+id/cbOnline" android:layout_width="match_parent" android:layout_height="40dp" android:text="Online Host" android:textColor="#D7EDF5" android:buttonTint="#14BFFF"/>
                <CheckBox android:id="@+id/cbForward" android:layout_width="match_parent" android:layout_height="40dp" android:text="Forward Host" android:textColor="#D7EDF5" android:buttonTint="#14BFFF"/>
                <CheckBox android:id="@+id/cbReverse" android:layout_width="match_parent" android:layout_height="40dp" android:text="Reverse Proxy" android:textColor="#D7EDF5" android:buttonTint="#14BFFF"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <CheckBox android:id="@+id/cbUser" android:layout_width="match_parent" android:layout_height="40dp" android:text="User Agent" android:textColor="#D7EDF5" android:buttonTint="#14BFFF"/>
                <CheckBox android:id="@+id/cbKeep" android:layout_width="match_parent" android:layout_height="40dp" android:text="Keep Alive" android:textColor="#D7EDF5" android:buttonTint="#14BFFF"/>
                <CheckBox android:id="@+id/cbReferer" android:layout_width="match_parent" android:layout_height="40dp" android:text="Referer" android:textColor="#D7EDF5" android:buttonTint="#14BFFF"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <CheckBox android:id="@+id/cbRaw" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Raw" android:textColor="#D7EDF5" android:buttonTint="#14BFFF"/>
            <CheckBox android:id="@+id/cbDual" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:text="Dual Connect" android:textColor="#D7EDF5" android:buttonTint="#14BFFF"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
